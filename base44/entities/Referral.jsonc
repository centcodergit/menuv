{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_id": { "type": "string", "description": "User id of the referrer (set by the backend function)" },
    "referrer_email": { "type": "string", "format": "email" },
    "referrer_name": { "type": "string" },
    "code": { "type": "string", "minLength": 8, "maxLength": 8, "description": "Unique 8-character referral code" },
    "clicks": { "type": "number", "default": 0, "description": "Visits through ?ref=code" },
    "signups": {
      "type": "array",
      "default": [],
      "description": "Friends who signed up with this code",
      "items": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "name": { "type": "string" },
          "signed_up_at": { "type": "string", "format": "date-time" },
          "has_purchased": { "type": "boolean", "default": false }
        }
      }
    },
    "reward_status": {
      "type": "string",
      "enum": ["pending", "earned", "redeemed"],
      "enumColors": ["gray", "yellow", "green"],
      "default": "pending",
      "description": "Free-menu reward, applied by the team"
    }
  },
  "required": ["referrer_id", "referrer_email", "code"],
  "rls": {
    "read": { "$or": [{ "data.referrer_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
