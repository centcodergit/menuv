{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "conversation_id": { "type": "string", "description": "SupportConversation id" },
    "conversation_owner_id": {
      "type": "string",
      "description": "User id of the customer who owns the conversation (lets them read admin replies)"
    },
    "sender_role": { "type": "string", "enum": ["user", "admin"], "enumColors": ["blue", "purple"] },
    "body": { "type": "string", "maxLength": 4000, "description": "Message text" }
  },
  "required": ["conversation_id", "conversation_owner_id", "sender_role", "body"],
  "rls": {
    "read": {
      "$or": [{ "data.conversation_owner_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }]
    },
    "create": {
      "$or": [
        { "$and": [{ "data.conversation_owner_id": "{{user.id}}" }, { "data.sender_role": "user" }] },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
