{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": { "type": "string", "format": "email", "description": "Subscriber email (unique, lower-case)" },
    "language": {
      "type": "string",
      "enum": ["el", "en", "de", "fr", "es", "it", "pt", "nl"],
      "description": "Site language when subscribing"
    },
    "source": { "type": "string", "description": "Where they subscribed, e.g. homepage" },
    "consent_at": { "type": "string", "format": "date-time", "description": "When consent was given" }
  },
  "required": ["email", "consent_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
